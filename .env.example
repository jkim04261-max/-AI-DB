# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
# 로컬 개발: 이 파일을 .env.local 로 복사하고 실제 키를 채워 넣으세요. (.env.local은 git에 커밋되지 않습니다)
# 배포: Vercel 프로젝트의 Settings → Environment Variables 에 동일한 이름으로 등록하세요.
# 절대 VITE_ 접두사를 붙이지 마세요 — 붙이면 브라우저 번들에 키가 그대로 노출됩니다.
GEMINI_API_KEY=

# (선택) 사용할 Gemini 모델. 비워두면 Google이 유지하는 안정적인 별칭인
# gemini-flash-latest를 사용합니다. 특정 모델이 필요하면 여기에 지정하세요.
GEMINI_MODEL=

# 로그인 세션(JWT)에 서명할 임의의 긴 비밀 문자열.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Vercel Postgres를 프로젝트에 연결(Storage 탭)하면 POSTGRES_URL 등은
# Vercel이 자동으로 채워주므로 직접 입력할 필요가 없습니다.
# 로컬에서 실제 DB에 붙여 테스트하려면 아래에 연결 문자열을 채우세요.
POSTGRES_URL=

# 채팅 이미지 첨부에 사용하는 Vercel Blob 저장소 토큰.
# Vercel 프로젝트의 Storage 탭에서 Blob 스토어를 생성해 연결하면
# 자동으로 채워지므로 보통 직접 입력할 필요는 없습니다.
BLOB_READ_WRITE_TOKEN=
